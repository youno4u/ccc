const canvas=document.getElementById('c');
const ctx=canvas.getContext('2d');
let W,H;
function resize(){W=canvas.width=window.innerWidth;H=canvas.height=window.innerHeight;}
window.addEventListener('resize',resize);resize();
const sx=()=>W/GW,sy=()=>H/GH;
function wp(wx,wy){return{x:wx*sx(),y:wy*sy()};}

let allPlayers={},saintHPs={},enemyHPs={};
let gameStartTime=0,pvsActive=false,pvsTeam=null,pvsEnd=0;
let localEnemies=[],processedWaves=new Set();
const STARS=Array.from({length:300},()=>({x:Math.random()*GW,y:Math.random()*GH,r:Math.random()*1.2+.3,a:Math.random()*.3+.06}));

function getSaintPos(team,idx,elapsedMs){
  const wps=SAINT_WP[team];const sId=team+idx;const hp=saintHPs[sId]??SAINT_MAX_HP;
  if(hp<=0)return{x:wps[0].x,y:wps[0].y,dead:true,reached:false};
  let totalLen=0;const segLens=[];
  for(let i=1;i<wps.length;i++){const dl=Math.hypot(wps[i].x-wps[i-1].x,wps[i].y-wps[i-1].y);segLens.push(dl);totalLen+=dl;}
  const offset=idx*20;const elapsedSec=Math.max(0,(elapsedMs-offset*1000/20)/1000);
  const dist=Math.min(elapsedSec*SAINT_SPD*60,totalLen);
  if(dist>=totalLen)return{x:wps[wps.length-1].x,y:wps[wps.length-1].y,dead:false,reached:true};
  let rem=dist;
  for(let i=0;i<segLens.length;i++){if(rem<=segLens[i]){const t=rem/segLens[i];return{x:wps[i].x+(wps[i+1].x-wps[i].x)*t,y:wps[i].y+(wps[i+1].y-wps[i].y)*t,dead:false,reached:false};}rem-=segLens[i];}
  return{x:wps[wps.length-1].x,y:wps[wps.length-1].y,dead:false,reached:true};
}
function getActiveSaints(){
  if(gameStartTime===0)return[];const elapsed=Date.now()-gameStartTime;const saints=[];
  for(const team of['A','B'])for(let i=0;i<NUM_SAINTS;i++){const s=getSaintPos(team,i,elapsed);saints.push({id:team+i,team,idx:i,...s});}
  return saints;
}

function processWaves(){
  if(gameStartTime===0)return;const elapsed=(Date.now()-gameStartTime)/1000;
  WAVES.forEach(([t,list],wi)=>{
    if(elapsed>=t&&!processedWaves.has(wi)){
      processedWaves.add(wi);
      list.forEach((e,ei)=>{
        const id=`w${wi}e${ei}`;if(!localEnemies.find(le=>le.id===id)){
          const et=ETYPES[e.t];localEnemies.push({id,type:e.t,x:e.x,y:e.y,hp:enemyHPs[id]??et.hp,maxHp:et.hp});
        }
      });
    }
  });
  localEnemies.forEach(e=>{const fbHp=enemyHPs[e.id];if(fbHp!==undefined)e.hp=fbHp;});
  localEnemies=localEnemies.filter(e=>e.hp>0);
}

function moveEnemies(saints){
  localEnemies.forEach(e=>{
    const et=ETYPES[e.type];let nearSaint=null,nearD=Infinity;
    saints.filter(s=>!s.dead&&!s.reached).forEach(s=>{const d=Math.hypot(s.x-e.x,s.y-e.y);if(d<nearD){nearD=d;nearSaint=s;}});
    if(!nearSaint)return;
    const dd=Math.hypot(nearSaint.x-e.x,nearSaint.y-e.y);
    if(dd>et.r+12){e.x+=(nearSaint.x-e.x)/dd*et.spd;e.y+=(nearSaint.y-e.y)/dd*et.spd;}
  });
}

function render(ts){
  processWaves();
  const saints=getActiveSaints();
  moveEnemies(saints);
  const SX=sx(),SY=sy();
  ctx.fillStyle='#050d0a';ctx.fillRect(0,0,W,H);
  STARS.forEach(s=>{ctx.fillStyle=`rgba(255,255,255,${s.a})`;ctx.beginPath();ctx.arc(s.x*SX,s.y*SY,s.r,0,Math.PI*2);ctx.fill();});
  // 길
  ctx.fillStyle='rgba(10,22,10,.9)';ctx.fillRect(0,255*SY,W,(GH-510)*SY);
  // 장애물
  WALLS.forEach(w=>{ctx.fillStyle='#0d2010';ctx.fillRect(w.x*SX,w.y*SY,w.w*SX,w.h*SY);ctx.strokeStyle='rgba(74,222,128,.12)';ctx.lineWidth=1;ctx.strokeRect(w.x*SX,w.y*SY,w.w*SX,w.h*SY);});
  // 스폰
  ['A','B'].forEach(t=>{const sp=SPAWN[t];const tc=t==='A'?'59,130,246':'239,68,68';ctx.fillStyle=`rgba(${tc},.07)`;ctx.strokeStyle=`rgba(${tc},.35)`;ctx.lineWidth=2;ctx.strokeRect((sp.x-55)*SX,(sp.y-65)*SY,110*SX,130*SY);ctx.fillRect((sp.x-55)*SX,(sp.y-65)*SY,110*SX,130*SY);ctx.fillStyle=`rgba(${tc},.5)`;ctx.font=`bold ${12*Math.min(SX,SY)*2}px Noto Sans KR`;ctx.textAlign='center';ctx.fillText(`팀 ${t} 출발`,sp.x*SX,(sp.y-73)*SY);});
  // 천국
  const hx=HEAVEN.x*SX,hy=HEAVEN.y*SY,hr=HEAVEN.r*Math.min(SX,SY);
  const pulse=.7+Math.sin(ts/500)*.3;
  const og=ctx.createRadialGradient(hx,hy,0,hx,hy,hr*3.5);og.addColorStop(0,`rgba(250,204,21,${.25*pulse})`);og.addColorStop(1,'rgba(250,204,21,0)');
  ctx.fillStyle=og;ctx.beginPath();ctx.arc(hx,hy,hr*3.5,0,Math.PI*2);ctx.fill();
  ctx.fillStyle=`rgba(250,204,21,${.15*pulse})`;ctx.strokeStyle=`rgba(250,204,21,${.9*pulse})`;ctx.lineWidth=2.5;ctx.shadowBlur=25;ctx.shadowColor='#facc15';ctx.beginPath();ctx.arc(hx,hy,hr,0,Math.PI*2);ctx.fill();ctx.stroke();ctx.shadowBlur=0;
  ctx.font=`bold ${hr*.85}px sans-serif`;ctx.fillStyle=`rgba(250,204,21,${pulse})`;ctx.textAlign='center';ctx.textBaseline='middle';ctx.shadowBlur=8;ctx.shadowColor='#facc15';ctx.fillText('✝',hx,hy);ctx.shadowBlur=0;
  ctx.font=`bold ${12*Math.min(SX,SY)*2}px Noto Sans KR`;ctx.fillStyle=`rgba(250,204,21,.8)`;ctx.textBaseline='top';ctx.fillText('천 국',hx,hy+hr+5);
  // 성도
  saints.forEach(s=>{
    if(s.dead||s.reached)return;const p={x:s.x*SX,y:s.y*SY};const r=13*Math.min(SX,SY);
    const isPvs=pvsActive&&pvsTeam===s.team;const hp=saintHPs[s.id]??SAINT_MAX_HP;const hpPct=hp/SAINT_MAX_HP;
    ctx.shadowBlur=isPvs?22:8;ctx.shadowColor=isPvs?'#facc15':'rgba(255,255,255,.5)';
    ctx.fillStyle=isPvs?'#fef08a':'rgba(255,255,255,.92)';ctx.beginPath();ctx.arc(p.x,p.y,r,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;
    ctx.font=`bold ${r*.85}px sans-serif`;ctx.fillStyle='#0a1628';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('✝',p.x,p.y);
    const bw=r*2.5,bh=3*Math.min(SX,SY),bx=p.x-bw/2,by=p.y-r-bh-4;
    ctx.fillStyle='#0f172a';ctx.fillRect(bx,by,bw,bh);if(bw*hpPct>0){ctx.fillStyle=hpPct>.5?'#4ade80':hpPct>.25?'#fbbf24':'#ef4444';ctx.fillRect(bx,by,bw*hpPct,bh);}
    ctx.fillStyle=s.team==='A'?'#93c5fd':'#fca5a5';ctx.font=`bold ${9*Math.min(SX,SY)*2}px Noto Sans KR`;ctx.textBaseline='top';ctx.fillText(s.team,p.x,p.y+r+2);
  });
  // 적
  localEnemies.forEach(e=>{
    const et=ETYPES[e.type];const p={x:e.x*SX,y:e.y*SY};const r=et.r*Math.min(SX,SY);const hpPct=e.hp/e.maxHp;
    ctx.shadowBlur=10;ctx.shadowColor=et.col;ctx.fillStyle=et.col;ctx.beginPath();ctx.arc(p.x,p.y,r,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;
    ctx.font=`bold ${r*.85}px sans-serif`;ctx.fillStyle='white';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(et.icon,p.x,p.y);
    const bw=r*2.4,bh=3*Math.min(SX,SY),bx=p.x-bw/2,by=p.y-r-5;
    ctx.fillStyle='#0f172a';ctx.fillRect(bx,by,bw,bh);if(bw*hpPct>0){ctx.fillStyle='#ef4444';ctx.fillRect(bx,by,bw*hpPct,bh);}
  });
  // 플레이어
  Object.values(allPlayers).filter(p=>p.alive).forEach(p=>{
    if(!p._rx){p._rx=p.x;p._ry=p.y;}p._rx+=(p.x-p._rx)*.15;p._ry+=(p.y-p._ry)*.15;
    const px=p._rx*SX,py=p._ry*SY,r=16*Math.min(SX,SY);
    const tc=p.team==='A'?'#3b82f6':'#ef4444';
    ctx.shadowBlur=10;ctx.shadowColor=tc;ctx.fillStyle=tc;ctx.beginPath();ctx.arc(px,py,r,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;
    ctx.font=`bold ${r*.52}px Noto Sans KR`;ctx.fillStyle='white';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText((p.name||'').slice(0,4),px,py);
    const hpPct=Math.max(0,(p.hp||0)/(p.maxHp||100));const bw=r*2.6,bh=3*Math.min(SX,SY),bx=px-bw/2,by=py-r-6;
    ctx.fillStyle='#0f172a';ctx.fillRect(bx,by,bw,bh);if(bw*hpPct>0){ctx.fillStyle=hpPct>.5?'#4ade80':hpPct>.25?'#fbbf24':'#ef4444';ctx.fillRect(bx,by,bw*hpPct,bh);}
    ctx.font=`bold ${9*Math.min(SX,SY)*2}px Noto Sans KR`;ctx.fillStyle='rgba(255,255,255,.5)';ctx.textBaseline='top';ctx.fillText(`Lv${(p.level||0)+1}`,px,py+r+4);
  });
  // HUD
  ctx.fillStyle='rgba(0,0,0,.6)';ctx.fillRect(0,0,W,36);
  if(gameStartTime>0){const elapsed=Math.floor((Date.now()-gameStartTime)/1000);const rem=Math.max(0,GAME_DURATION-elapsed);const m=Math.floor(rem/60),s=rem%60;ctx.fillStyle=rem<60?'#ef4444':rem<120?'#fbbf24':'rgba(255,255,255,.7)';ctx.font=`bold ${16*Math.min(SX,SY)*2}px Noto Sans KR`;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(`${m}:${String(s).padStart(2,'0')}`,W/2,18);}
  const sA=getActiveSaints().filter(s=>s.team==='A');const sB=getActiveSaints().filter(s=>s.team==='B');
  ctx.font=`bold ${13*Math.min(SX,SY)*2}px Noto Sans KR`;ctx.textAlign='left';ctx.textBaseline='middle';
  ctx.fillStyle='#93c5fd';ctx.fillText(`🔵 팀A — 성도 ${sA.filter(s=>s.reached).length}/5 도착`,12,18);
  ctx.textAlign='right';ctx.fillStyle='#fca5a5';ctx.fillText(`팀B — 성도 ${sB.filter(s=>s.reached).length}/5 도착 🔴`,W-12,18);
