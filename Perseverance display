  {x:1820,y:180,w:32,h:32},{x:1820,y:680,w:32,h:32},{x:2148,y:180,w:32,h:32},{x:2148,y:680,w:32,h:32},
  {x:3495,y:25,w:35,h:160},{x:3495,y:245,w:35,h:155},{x:3495,y:460,w:35,h:20},{x:3495,y:540,w:35,h:195},{x:3495,y:790,w:35,h:85},
