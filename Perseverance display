  [410,[{t:'boss',x:600,y:0},{t:'boss',x:800,y:GH},{t:'boss',x:1000,y:0},{t:'boss',x:1200,y:GH},{t:'giant',x:700,y:0},{t:'boss',x:3400,y:0},{t:'boss',x:3200,y:GH},{t:'boss',x:3000,y:0},{t:'boss',x:2800,y:GH}]],
