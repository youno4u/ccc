  {x:0,y:0,w:GW,h:25},{x:0,y:GH-25,w:GW,h:25},{x:0,y:0,w:25,h:GH},{x:GW-25,y:0,w:25,h:GH},
  {x:470,y:25,w:35,h:160},{x:470,y:245,w:35,h:155},{x:470,y:460,w:35,h:20},{x:470,y:540,w:35,h:195},{x:470,y:790,w:35,h:85},
