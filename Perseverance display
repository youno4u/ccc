  else{document.getElementById('pvs-banner').style.display='none';}
  requestAnimationFrame(render);
}
requestAnimationFrame(render);

function setup(){
  onSnapshot(STATE,snap=>{
    if(!snap.exists())return;const d=snap.data();const ns=d.gameStatus||'lobby';
    pvsActive=d.perseveranceActive||false;pvsTeam=d.perseveranceTeam||null;pvsEnd=d.perseveranceEnd||0;
    if(d.gameStartTime)gameStartTime=d.gameStartTime;
    document.getElementById('lobby').classList.toggle('hidden',ns==='playing');
    if(d.winner&&ns==='ended'){const tc=d.winner==='A'?'#93c5fd':d.winner==='draw'?'#fbbf24':'#fca5a5';document.getElementById('win-tit').textContent=d.winner==='draw'?'⚔ 무승부!':`팀 ${d.winner} 승리! ✝`;document.getElementById('win-tit').style.color=tc;document.getElementById('win').classList.add('show');}
    else{document.getElementById('win').classList.remove('show');}
    if(ns==='reset'){allPlayers={};localEnemies=[];processedWaves=new Set();gameStartTime=0;document.getElementById('win').classList.remove('show');}
  });
  onSnapshot(PCOL,snap=>{
    const uids=new Set();snap.forEach(d=>{const uid=d.id;uids.add(uid);if(!allPlayers[uid])allPlayers[uid]={...d.data(),uid};else Object.assign(allPlayers[uid],d.data(),{uid});});
    Object.keys(allPlayers).forEach(uid=>{if(!uids.has(uid))delete allPlayers[uid];});
    const cnt={A:0,B:0};snap.forEach(d=>{const t=d.data().team;if(t)cnt[t]++;});
    document.getElementById('lb-cnt').textContent=`🔵 팀A: ${cnt.A}명 | 🔴 팀B: ${cnt.B}명`;
  });
  onSnapshot(ECOL,snap=>{snap.forEach(d=>{enemyHPs[d.id]=d.data().hp??0;});});
  onSnapshot(SCOL,snap=>{snap.forEach(d=>{saintHPs[d.id]=d.data().hp??SAINT_MAX_HP;});});
}
try{await signInAnonymously(auth);setup();}catch(e){console.error(e);}
</script>
